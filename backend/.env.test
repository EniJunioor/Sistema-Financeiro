# Ambiente de testes automatizados.
# Banco isolado: é recriado do zero antes de cada execução da suíte.
NODE_ENV="test"
PORT=3001

DATABASE_URL="file:./test.db"

REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD="redis123"

JWT_SECRET="test-jwt-secret-not-used-in-production"
JWT_EXPIRES_IN="24h"

ENCRYPTION_SECRET="test-encryption-secret-32-chars-ok"
PRIVACY_POLICY_VERSION="1.0.0"
LGPD_DELETION_GRACE_PERIOD_DAYS=30
